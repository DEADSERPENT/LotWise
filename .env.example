# Copy to .env and adjust. Never commit real secrets.

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=lotwise
POSTGRES_PASSWORD=lotwise_dev_password
POSTGRES_DB=lotwise
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lotwise:lotwise_dev_password@localhost:5432/lotwise?schema=public

# --- Backend ---
PORT=4000
# Generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m

# --- Initial admin (used by the seed command only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
