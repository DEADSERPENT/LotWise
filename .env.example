# Copy to .env and adjust. Never commit real secrets.

# --- Database (matches docker-compose.yml; local dev only, bound to 127.0.0.1) ---
# 5434 avoids clashing with a native PostgreSQL on 5432.
POSTGRES_USER=lotwise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lotwise
POSTGRES_PORT=5434
DATABASE_URL=postgresql://lotwise:change-me@localhost:5434/lotwise?schema=public

# --- Backend ---
PORT=4000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m

# --- Initial admin (used by the seed command only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
